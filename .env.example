# PostHog Configuration
# Get your PostHog API key and host from your PostHog project settings
# For PostHog Cloud, use: https://app.posthog.com
# For self-hosted PostHog, use your instance URL

NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_api_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
