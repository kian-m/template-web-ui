GOOGLE_CLIENT_ID=your-google-oauth-client-id



































GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
NEXTAUTH_SECRET=generate-a-random-secret
# NEXTAUTH_URL=http://localhost:3000

# Comma-separated list of admin emails
ADMIN_EMAILS=

# Google Service Account (server-only)
# From your service account JSON. Paste the private key with literal \n characters.
# Example: GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nABC...\n-----END PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_PROJECT_ID=

# Google Sheets
# Share the target spreadsheet with your service account email.
GOOGLE_SHEETS_SPREADSHEET_ID=
